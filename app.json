{
  "expo": {
    "name": "Huilerie Aka.Jo",
    "slug": "huilerie-akajo",
    "scheme": "huilerie-akajo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-akajo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-sqlite", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akajo.huilerie"
    },
    "android": {
      "package": "com.akajo.huilerie",
      "adaptiveIcon": {
        "backgroundColor": "#1C1A17",
        "foregroundImage": "./assets/images/logo-akajo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/logo-akajo.png",
      "bundler": "metro"
    }
  }
}
